# ==============================================================================
# iTantra (PS26173) - Environment Configuration Template
# Copy this file to '.env' and populate with local runtime values if needed.
# ==============================================================================

# Tactical Edge Transceiver Network Configuration
ITANTRA_DEVICE_ROLE=RECEIVER
ITANTRA_HOST=0.0.0.0
ITANTRA_PORT=42173
ITANTRA_PEER_HOST=10.179.231.166
ITANTRA_PEER_PORT=42173

# Audio & Speech Processing Pipeline
ITANTRA_SAMPLE_RATE=16000
ITANTRA_CHANNELS=1
ITANTRA_VAD_THRESHOLD=0.5
ITANTRA_DEFAULT_LANGUAGE=en

# Model Paths & Resources
ITANTRA_ASR_MODEL_DIR=app/src/main/assets/models/whisper-tiny
ITANTRA_TTS_MODEL_DIR=app/src/main/assets/vits-piper-en_US-lessac-low

# Debug & Telemetry Flags
ITANTRA_DEBUG=false
ITANTRA_LOG_LEVEL=INFO
